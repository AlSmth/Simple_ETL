# Токен бота от @BotFather.
# Не используйте токен бота, который уже где-то запущен: Telegram отдаёт обновления только одному.
BOT_TOKEN=

# Chat id менеджеров через запятую (узнать свой: отправьте боту /myid).
# Менеджеры получают все заявки, одобряют мастеров и переписываются с агентом.
MANAGER_CHAT_IDS=

# Ключ Claude API для агента. Без него бот работает, а агент выключен.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
AGENT_EFFORT=medium

# Стоимость выезда, которая записывается в заявку при закрытии, и валюта
VISIT_FEE=0
CURRENCY=AMD
DEFAULT_CITY=Yerevan

# Базы. В docker compose эти значения подставляются сами (см. docker-compose.yaml),
# здесь — для запуска бота или агента с хоста: python -m app.bot / python -m app.agent
DATABASE_URL=postgresql://app:app@localhost:5436/handyman
AGENT_DATABASE_URL=postgresql://agent_ro:agent_ro@localhost:5436/handyman
AGENT_DWH_URL=postgresql://agent_ro:agent_ro@localhost:5436/dwh
